{
  "name": "wallpaper-sync-vscode",
  "displayName": "Wallpaper to VS Code",
  "icon": "assets/icon.png",
  "description": "A plugin that integrates Wallpaper engines into VS Code",
  "version": "0.8.0",
  "publisher": "domichung-wallpaper",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wallpaperSync",
          "title": "Wallpaper",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "wallpaperSync": [
        {
          "id": "wallpaperSync.controls",
          "name": "%view.controls%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "wallpaperSync.start",
        "title": "%command.start%"
      },
      {
        "command": "wallpaperSync.stop",
        "title": "%command.stop%"
      },
      {
        "command": "wallpaperSync.uninstall",
        "title": "%command.uninstall%"
      },
      {
        "command": "wallpaperSync.textOpacity",
        "title": "%command.textOpacity%"
      },
      {
        "command": "wallpaperSync.videoOpacity",
        "title": "%command.videoOpacity%"
      },
      {
        "command": "wallpaperSync.switchMode",
        "title": "%command.switchMode%"
      },
      {
        "command": "wallpaperSync.openPanel",
        "title": "%command.openPanel%"
      }
    ],
    "configuration": {
      "title": "Wallpaper Sync",
      "properties": {
        "wallpaperSync.mode": {
          "type": "string",
          "enum": [
            "wallpaperEngine",
            "folder"
          ],
          "default": "wallpaperEngine",
          "description": "%setting.mode%"
        },
        "wallpaperSync.folderPath": {
          "type": "string",
          "default": "",
          "description": "%setting.folderPath%"
        },
        "wallpaperSync.slideshowSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 2,
          "maximum": 3600,
          "description": "%setting.slideshowSeconds%"
        },
        "wallpaperSync.executable": {
          "type": "string",
          "default": "",
          "description": "%setting.executable%"
        },
        "wallpaperSync.monitor": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "description": "%setting.monitor%"
        },
        "wallpaperSync.pollSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 3600,
          "description": "%setting.pollSeconds%"
        },
        "wallpaperSync.opacity": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1,
          "description": "%setting.opacity%"
        },
        "wallpaperSync.textOpacity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%setting.textOpacity%"
        },
        "wallpaperSync.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-tw",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%setting.language%",
          "enumDescriptions": [
            "%language.auto%",
            "%language.zh%",
            "%language.en%"
          ]
        }
      }
    }
  },
  "scripts": {
    "start": "cmd /c start-extension.cmd",
    "test": "node --test",
    "package": "npx --yes --package @vscode/vsce vsce package --readme-path README.marketplace.md --no-dependencies --allow-missing-repository --skip-license"
  }
}
